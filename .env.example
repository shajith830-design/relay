# Copy to .env and replace every example value before deployment.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
INQUIRIES_API_TOKEN=replace-with-a-unique-random-inquiries-token
OWNER_ADMIN_TOKEN=replace-with-a-separate-unique-random-admin-token
RESEND_API_KEY=replace-with-your-email-provider-api-key
AUTH_EMAIL_FROM="Relay <no-reply@example.com>"
PUBLIC_BASE_URL=https://relay.example.com
TRUST_PROXY_HOPS=1

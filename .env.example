# Copy to .env and replace every example value before deployment.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
INQUIRIES_API_TOKEN=replace-with-a-unique-random-inquiries-token
OWNER_ADMIN_TOKEN=replace-with-a-separate-unique-random-admin-token
RESEND_API_KEY=replace-with-your-email-provider-api-key
AUTH_EMAIL_FROM="Relay <no-reply@example.com>"
INQUIRY_NOTIFICATION_EMAIL=inquiries@example.com
NOTIFICATIONS_CRON_SECRET=replace-with-a-unique-high-entropy-secret
MALWARE_SCANNER_URL=https://scanner.example.com/scan
MALWARE_SCANNER_TOKEN=replace-with-a-unique-high-entropy-secret
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
SCANNER_HOST=0.0.0.0
SCANNER_PORT=8788
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
HUBSPOT_CLIENT_ID=replace-with-hubspot-oauth-client-id
HUBSPOT_CLIENT_SECRET=replace-with-hubspot-oauth-client-secret
SALESFORCE_CLIENT_ID=replace-with-salesforce-connected-app-client-id
SALESFORCE_CLIENT_SECRET=replace-with-salesforce-connected-app-client-secret
SALESFORCE_LOGIN_URL=https://login.salesforce.com
JUSTONECX_SECRET_KEY=
PUBLIC_BASE_URL=https://relay.example.com
TRUST_PROXY_HOPS=1

# Copy to .env and replace every example value before deployment.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id
INQUIRIES_API_TOKEN=replace-with-a-long-random-secret
OWNER_ADMIN_TOKEN=replace-with-a-different-long-random-secret
RESEND_API_KEY=replace-with-your-email-provider-api-key
AUTH_EMAIL_FROM="Relay <no-reply@example.com>"
INQUIRY_NOTIFICATION_EMAIL=relayautomations@gmail.com
PUBLIC_BASE_URL=https://relay.example.com
TRUST_PROXY_HOPS=1
# Optional. Leave blank to disable Ray; configure only if Ray is enabled for launch.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  // Keep iconv-lite on its browser path; Wrangler otherwise bundles its Node stream helpers as disabled stubs.
  "define": {
    "process.versions.node": "undefined"
  },
  "workers_dev": true,
  "route": {
    "pattern": "relayautomation.tech/*",
    "zone_name": "relayautomation.tech"
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://relayautomation.tech",
    "TRUST_PROXY_HOPS": "1"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/healthz",
      "/inquiries",
      "/admin/*"
    ],
    "not_found_handling": "404-page"
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["migrations/*.sql"],
      "fallthrough": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "05eed65be0dd4848925d4f8bb6d31253"
    }
  ],
  "observability": {
    "enabled": true
  }
}

{
  "name": "relay-automation-inquiries",
  "version": "1.0.0",
  "private": true,
  "description": "Customer onboarding inquiry intake for Relay Automation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "backup": "node scripts/backup-database.js",
    "db:migrate": "node scripts/migrate.js",
    "provision:workspace": "node scripts/provision-workspace.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "wrangler": "^4.156.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true
  }
}
